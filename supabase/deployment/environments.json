      "allowDemoOrFake": false,
      "requiresProductionConfirmation": false
    },
    "production": {
      "projectRef": "SET_PRODUCTION_PROJECT_REF",
      "githubEnvironment": "production",
      "allowedBranches": [
        "master"
      ],
      "allowDemoOrFake": false,
      "requiresProductionConfirmation": true
    }
  }
