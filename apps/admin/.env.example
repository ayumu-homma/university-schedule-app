# Local admin app only. Staging and production must set an explicit public URL.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_ACCOUNT_DELETION_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# These pages return 404 unless publication is explicitly enabled and the
# page-specific approved text/contact is provided through server-side config.
PUBLIC_LEGAL_PAGES_ENABLED=false
APPROVED_PRIVACY_POLICY_TEXT=
APPROVED_TERMS_OF_SERVICE_TEXT=
APPROVED_SUPPORT_CONTACT=
