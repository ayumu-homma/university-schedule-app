<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MorningAlarmTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#315BA8</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F8FC</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="MorningAlarmActionTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
