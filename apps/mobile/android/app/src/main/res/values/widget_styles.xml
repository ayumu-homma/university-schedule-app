<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#17243A</item>
        <item name="android:textSize">9sp</item>
        <item name="android:background">@drawable/widget_empty_cell_background</item>
    </style>

    <style name="WidgetDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#17243A</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/widget_day_background</item>
    </style>

    <style name="WidgetPeriod">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">3</item>
        <item name="android:textColor">#40516D</item>
        <item name="android:textSize">7sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
