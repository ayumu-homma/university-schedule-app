<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:text="@string/weekly_timetable_widget_title"
        android:textColor="#17243A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/weekly_timetable_widget_sync_prompt"
        android:textColor="#40516D"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">

            <TextView
                style="@style/WidgetPeriod"
                android:text="" />

            <TextView
                android:id="@+id/widget_day_1"
                style="@style/WidgetDay"
                android:text="@string/weekday_monday" />

            <TextView
                android:id="@+id/widget_day_2"
                style="@style/WidgetDay"
                android:text="@string/weekday_tuesday" />

            <TextView
                android:id="@+id/widget_day_3"
                style="@style/WidgetDay"
                android:text="@string/weekday_wednesday" />

            <TextView
                android:id="@+id/widget_day_4"
                style="@style/WidgetDay"
                android:text="@string/weekday_thursday" />

            <TextView
                android:id="@+id/widget_day_5"
                style="@style/WidgetDay"
                android:text="@string/weekday_friday" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_period_1"
                style="@style/WidgetPeriod"
                android:text="@string/period_one" />

            <TextView
                android:id="@+id/widget_cell_1_1"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_1_2"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_1_3"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_1_4"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_1_5"
                style="@style/WidgetCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_period_2"
                style="@style/WidgetPeriod"
                android:text="@string/period_two" />

            <TextView
                android:id="@+id/widget_cell_2_1"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_2_2"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_2_3"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_2_4"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_2_5"
                style="@style/WidgetCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_period_3"
                style="@style/WidgetPeriod"
                android:text="@string/period_three" />

            <TextView
                android:id="@+id/widget_cell_3_1"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_3_2"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_3_3"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_3_4"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_3_5"
                style="@style/WidgetCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_period_4"
                style="@style/WidgetPeriod"
                android:text="@string/period_four" />

            <TextView
                android:id="@+id/widget_cell_4_1"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_4_2"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_4_3"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_4_4"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_4_5"
                style="@style/WidgetCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_period_5"
                style="@style/WidgetPeriod"
                android:text="@string/period_five" />

            <TextView
                android:id="@+id/widget_cell_5_1"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_5_2"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_5_3"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_5_4"
                style="@style/WidgetCell" />

            <TextView
                android:id="@+id/widget_cell_5_5"
                style="@style/WidgetCell" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
