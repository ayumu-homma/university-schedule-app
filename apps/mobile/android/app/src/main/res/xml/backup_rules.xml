<?xml version="1.0" encoding="utf-8"?>
<!--
  Schedule, relationship, document-review, and authentication state are
  sensitive. Server-backed data must be restored through authenticated sync,
  not copied from an operating-system backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
