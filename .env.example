# App
APP_ENV=local
APP_DEMO_MODE=true
# Android local/test/staging builds use --flavor staging and must set this to
# unischedule-staging. The production flavor uses unischedule.
APP_DEEP_LINK_SCHEME=unischedule-staging
APP_WEB_BASE_URL=http://127.0.0.1:3000
# Policy/support links may be empty in local/test; they derive from a valid
# APP_WEB_BASE_URL or remain disabled as unpublished. APP_ACCOUNT_DELETION_URL
# derives /account-deletion locally; staging/production require explicit public
# HTTPS URLs for all routes.
APP_PRIVACY_POLICY_URL=
APP_TERMS_URL=
APP_ACCOUNT_DELETION_URL=
APP_SUPPORT_URL=
EMAIL_IMPORT_ENABLED=false
# Public mobile OAuth client identifier required only when Email import is
# enabled. Never put the Gmail OAuth client secret in mobile configuration.
EMAIL_IMPORT_GMAIL_CLIENT_ID=
DOCUMENT_IMPORT_ENABLED=false

# Public project identifiers and client values only. Deployed builds require
# the selected APP_ENV ref; the other may be empty, and both must differ when
# supplied. SUPABASE_URL must match the selected ref.
# Never put service_role, sb_secret_, or provider keys in mobile configuration.
STAGING_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy client-key alias; leave empty when SUPABASE_PUBLISHABLE_KEY is used.
SUPABASE_ANON_KEY=

# Optional observability / notifications
SENTRY_DSN=
FCM_SENDER_ID=
FCM_PROJECT_ID=
APNS_BUNDLE_ID=

# Widget bridge
IOS_APP_GROUP_ID=group.jp.example.universityschedule
ANDROID_WIDGET_PREFS_NAME=weekly_timetable_widget

# Document extraction credentials are Edge Function secrets. Never expose
# OPENAI_API_KEY or other provider secrets through Flutter dart-defines.
